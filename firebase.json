{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "target": "talosone",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [{"source": "**", "headers": [{"key": "Cache-Control", "value": "public,max-age=0,must-revalidate"}]}],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
